
# Application
# Name of the application
APP_NAME=AgentSec AI
# Environment (development|production)
APP_ENV=development
# Debug mode (True|False)
APP_DEBUG=True
# A random secret key (64 hex chars) — DO NOT COMMIT REAL SECRETS
SECRET_KEY=
# Comma-separated allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Async SQLAlchemy URL: postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=
STORAGE_BACKEND=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=5432

# Redis
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379

# Celery
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# JWT Auth
# Generate a 64-char secret for production
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# AI / LLM keys (leave blank if unused)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Notifications
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Tools paths (inside container)
TOOLS_BASE_PATH=/opt/tools
SUBFINDER_PATH=/usr/local/bin/subfinder
AMASS_PATH=/usr/local/bin/amass
NMAP_PATH=/usr/bin/nmap
NUCLEI_PATH=/usr/local/bin/nuclei
HTTPX_PATH=/usr/local/bin/httpx
NAABU_PATH=/usr/local/bin/naabu
KATANA_PATH=/usr/local/bin/katana

# Scan settings
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT_SECONDS=3600
TOOL_TIMEOUT_SECONDS=300
SCAN_RATE_LIMIT_PER_MINUTE=30
DNS_RESOLVERS=1.1.1.1,8.8.8.8
NUCLEI_TEMPLATES_PATH=/opt/nuclei-templates
NUCLEI_AUTO_UPDATE=false
FLOWER_BASIC_AUTH=admin:change-this-password
